# ==========================================
# CampusKart Environment Configuration
# ==========================================

# 1. Supabase Settings (Public & Server Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Groq AI & Vision API Key (Server Side Only)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 3. Resend Transactional Email Engine (Server Side Only)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=CampusKart <onboarding@resend.dev>

# 4. App Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
